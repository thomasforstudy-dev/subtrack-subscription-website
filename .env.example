# Copy this file to .env and fill it in. Never commit .env to GitHub.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- SQL Server ---------------------------------------------------------
# Leave DB_SERVER empty to use a local SQLite test file instead.
DB_SERVER='localhost\SQLEXPRESS'
DB_NAME=SubTrack
DB_DRIVER=ODBC Driver 18 for SQL Server
# Leave DB_USER empty to log in with your Windows account (simplest).
DB_USER=
DB_PASSWORD=

# --- Email (Day 4) ------------------------------------------------------
MAIL_FROM=reminders@yourdomain.com
MAIL_REPLY_TO=you@gmail.com
# RESEND_API_KEY=
