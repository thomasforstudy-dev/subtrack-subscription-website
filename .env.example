# Copy this file to .env and fill it in. Never commit .env to GitHub.

# A long random string (32+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# production (the live site; the default) or development (testing on this PC).
# Production refuses to start without a real SECRET_KEY and sends login
# cookies over HTTPS only.
APP_ENV=production
# Who may tell us a visitor's real address (Cloudflare Tunnel runs on this PC).
TRUSTED_PROXIES=127.0.0.1,::1

# --- SQL Server ---------------------------------------------------------
# Leave DB_SERVER empty to use a local SQLite test file instead.
DB_SERVER='localhost\SQLEXPRESS'
DB_NAME=SubTrack
DB_DRIVER=ODBC Driver 18 for SQL Server
# Leave DB_USER empty to log in with your Windows account (simplest).
DB_USER=
DB_PASSWORD=

# --- Email ---------------------------------------------------------------
# MAIL_BACKEND: resend (really send), file (save to instance/outbox/ to read
# on this PC), memory (tests) or none. Empty = resend if RESEND_API_KEY is
# set, file if APP_ENV=development, otherwise none.
MAIL_BACKEND=
MAIL_FROM=SubTrack <reminders@yourdomain.com>
MAIL_REPLY_TO=you@gmail.com
RESEND_API_KEY=

# --- Reminders ------------------------------------------------------------
# Time zone for new accounts (each person can change theirs in Settings).
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# --- Subby help bot: where people can message you -----------------------
# Must start with https://. Leave empty to hide that button.
MESSENGER_URL=https://m.me/your.page.or.username
ZALO_URL=https://zalo.me/0900000000

# --- Subby's brain (Gemini) ------------------------------------------------
# Free key from https://aistudio.google.com/app/apikey . Without it, Subby
# uses its small built-in answer list.
GEMINI_API_KEY=
# Comma-separated: the first model, then backups if it's busy.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest

# --- Sign in with Google / GitHub -------------------------------------------
# The public address of the site (no slash at the end). Google/GitHub send
# people back to SITE_URL/auth/google/callback and SITE_URL/auth/github/callback.
SITE_URL=https://alloutdeepclean.com
# Leave a pair empty to hide that button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
